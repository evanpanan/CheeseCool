NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported if no publishable key is set.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
KIMI_API_KEY=
KIMI_CHAT_MODEL=kimi-k2.5
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
AI_SETTINGS_ENCRYPTION_KEY=
AI_PROVIDER=openai
AI_ADMIN_USER_IDS=
SUPABASE_SECRET_KEY=

NEXT_PUBLIC_SITE_URL=

# Required for persistent processing and scheduled maintenance
CRON_SECRET=
# Stable 32-byte hex root. Store an offline copy using admin recovery download.
BACKUP_ENCRYPTION_KEY=
# Optional independent S3-compatible disaster copy
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Aliyun capability credentials are configured in Site Management, not public variables.
